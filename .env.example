# ==============================================================================
# CEFAN - ARQUIVO DE CONFIGURAÇÃO DE EXEMPLO (.env.example)
#
# Instruções:
# 1. Duplique este arquivo para .env na raiz do projeto:
#    cp .env.example .env
# 2. Preencha as credenciais abaixo com seus valores reais ou gerados.
# ==============================================================================

# ==========================================
# EVOLUTION API - CONFIGURAÇÕES DO SERVIDOR
# ==========================================
SERVER_NAME=evolution-api
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

# ==========================================
# AUTENTICAÇÃO
# ==========================================
AUTHENTICATION_TYPE=apikey
# Substitua pela sua chave de API global (ex: chave alfanumérica forte ou UUID)
AUTHENTICATION_API_KEY=sua_chave_apikey_aqui
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ==========================================
# BANCO DE DADOS (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_postgres_aqui
POSTGRES_DB=evolution

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://postgres:sua_senha_postgres_aqui@postgres:5432/evolution?schema=public'
DATABASE_CONNECTION_CLIENT_NAME=evolution_api

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# ==========================================
# CACHE (Redis)
# ==========================================
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ==========================================
# CORS E LOGS
# ==========================================
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,VERBOSE,DARK,WEBHOOKS
LOG_COLOR=true
LOG_BAILEYS=error

# ==========================================
# CONFIGURAÇÕES DE SESSÃO DO WHATSAPP
# ==========================================
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR='#175197'

# ==========================================
# WEBSOCKET
# ==========================================
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false

# ==========================================
# PGADMIN
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@exemplo.com
PGADMIN_DEFAULT_PASSWORD=sua_senha_pgadmin_aqui

# ==========================================
# TELEMETRIA E IDIOMA
# ==========================================
TELEMETRY_ENABLED=true
LANGUAGE=pt-BR
