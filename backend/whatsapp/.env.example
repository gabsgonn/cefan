# ==============================================================================
# CEFAN BACKEND WHATSAPP - VARIÁVEIS DE AMBIENTE (.env.example)
#
# Instruções:
# Caso utilize variáveis de ambiente diretamente no backend ou container:
# cp .env.example .env
# ==============================================================================

SERVER_PORT=8082

# Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cefan
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_postgres_aqui

# Integração Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_apikey_aqui
EVOLUTION_API_INSTANCE_NAME=cefan-studio
